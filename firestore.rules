rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'hussein.zebary.chemistry96@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Collection Matches ---

    // /projects/{projectId}
    match /projects/{projectId} {
      allow get: if isSignedIn() && isValidId(projectId);
      allow list: if isSignedIn();
      
      allow create: if isSignedIn() 
        && isValidId(projectId)
        && (request.resource.data.userId == request.auth.uid || isAdmin());
        
      allow update: if isSignedIn()
        && isValidId(projectId)
        && (isAdmin() || resource.data.userId == request.auth.uid);
        
      allow delete: if isSignedIn() 
        && (resource.data.userId == request.auth.uid || isAdmin())
        && isValidId(projectId);
    }

    // /users/{userId}
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId) && isValidId(userId);
      allow list: if isSignedIn() && isOwner(userId);
      
      allow create: if isSignedIn()
        && isOwner(userId)
        && isValidId(userId);
        
      allow update: if isSignedIn()
        && isOwner(userId)
        && isValidId(userId);
        
      allow delete: if isSignedIn() 
        && isOwner(userId)
        && isValidId(userId);
    }
  }
}
