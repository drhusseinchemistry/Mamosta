  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  }
}
