# .env.example
# Your Google Gemini API Key for transcription, OCR, questions generation, and styling improvement
VITE_GEMINI_API_KEY=

# Custom Firebase credentials for Netlify/GitHub hosting (Optional - falls back to sandboxed config if not provided)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
